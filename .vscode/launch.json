{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "C/C++: Debug approacher",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/approacher",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "为 gdb 启用整齐打印",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "C/C++: g++ build approacher",
            "miDebuggerPath": "/usr/bin/gdb"
        }
    ]
}